rules_version = '2';

service firebase.storage {
  match /b/{bucket}/o {
    // Permitir leitura pública de banners
    match /banners/{allPaths=**} {
      allow read: if true; // Leitura pública para todos
      allow write: if request.auth != null; // Escrita apenas para usuários autenticados
    }
    
    // Fotos sociais do Match — somente a pasta do próprio UID
    match /match-profiles/{userId}/photos/{fileName} {
      allow read: if request.auth != null && request.auth.uid == userId;
      allow create, update: if request.auth != null
        && request.auth.uid == userId
        && request.resource.size < 5 * 1024 * 1024
        && (request.resource.contentType == 'image/jpeg'
          || request.resource.contentType == 'image/png'
          || request.resource.contentType == 'image/webp');
      allow delete: if request.auth != null && request.auth.uid == userId;
    }

    // Para outros arquivos, manter bloqueado por segurança
    match /{allPaths=**} {
      allow read, write: if false;
    }
  }
}
