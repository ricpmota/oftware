rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {
    function isHydrationProtectedPath() {
      let n = request.path.size();
      return n >= 2 && (
        request.path[n - 2] == 'hidratacao_checkin_links'
        || request.path[n - 2] == 'hydration_checkin_deliveries'
        || request.path[n - 2] == 'hydration_checkin_cron_state'
        || request.path[n - 2] == 'hydration_adherence_alerts'
        || (
          n >= 4
          && request.path[n - 4] == 'nutricao'
          && request.path[n - 3] == 'dados'
          && request.path[n - 2] == 'hidratacao'
        )
      );
    }

    function isMatchProfilePath() {
      let n = request.path.size();
      return (n >= 2 && request.path[n - 2] == 'match_profiles')
        || (n >= 4 && request.path[n - 4] == 'match_profiles');
    }

    function isMatchSocialPath() {
      let n = request.path.size();
      return (n >= 2 && (
        request.path[n - 2] == 'match_connection_requests'
        || request.path[n - 2] == 'match_connections'
        || request.path[n - 2] == 'match_blocks'
        || request.path[n - 2] == 'match_conversations'
        || request.path[n - 2] == 'match_discovery_profiles'
        || request.path[n - 2] == 'match_passes'
      )) || (
        n >= 4
        && request.path[n - 4] == 'match_conversations'
        && request.path[n - 2] == 'messages'
      );
    }

    // Regras para sistema médico existente
    match /doctors/{doctorId} {
      allow read, write: if request.auth != null && request.auth.uid == doctorId;
    }
    
    match /patients/{patientId} {
      allow read, write: if request.auth != null;
    }
    
    // Regras para sistema de escalas
    match /users/{userId} {
      allow read, write: if request.auth != null;
    }
    
    match /residentes/{residenteId} {
      allow read, write: if request.auth != null;
    }
    
    match /locais/{localId} {
      allow read, write: if request.auth != null;
    }
    
    match /servicos/{servicoId} {
      allow read, write: if request.auth != null;
    }
    
    match /escalas/{escalaId} {
      allow read, write: if request.auth != null;
    }
    
    // Regras para sistema de trocas
    match /trocas/{trocaId} {
      allow read, write: if request.auth != null;
    }
    
    match /notificacoes_troca/{notificacaoId} {
      allow read, write: if request.auth != null;
    }
    
    // Regras para férias
    match /ferias/{feriasId} {
      allow read, write: if request.auth != null;
    }
    
    match /notificacoes_ferias/{notificacaoId} {
      allow read, write: if request.auth != null;
    }
    
    // NOVA: Regras para notificações internas
    match /notificacoes/{notificationId} {
      allow read, write: if request.auth != null;
    }
    
    // Logs de notificações (caso ainda existam)
    match /notification_logs/{logId} {
      allow read, write: if request.auth != null;
    }
    
    // Regras para sistema de mensagens
    match /mensagens/{mensagemId} {
      allow read, write: if request.auth != null;
    }
    
    match /mensagens_residentes/{mensagemResidenteId} {
      allow read, write: if request.auth != null;
    }
    
    // Regras para pacientes_completos e subcoleções (nutricao)
    match /pacientes_completos/{pacienteId} {
      allow read, write: if request.auth != null;

      // Subcoleção nutricao — hidratação tem matcher próprio abaixo
      match /nutricao/{nutricaoDocId} {
        allow read, write: if request.auth != null;
        match /{subcol}/{subdocId} {
          allow read, write: if request.auth != null && subcol != 'hidratacao';
        }
      }

      // Controle diário de hidratação — dono ou profissional vinculado (leitura)
      match /nutricao/dados/hidratacao/{date} {
        function hydrationPaciente() {
          return get(/databases/$(database)/documents/pacientes_completos/$(pacienteId)).data;
        }
        function isHydrationPatientOwner() {
          return request.auth != null
            && exists(/databases/$(database)/documents/pacientes_completos/$(pacienteId))
            && hydrationPaciente().userId == request.auth.uid;
        }
        function medicoResponsavelId() {
          return hydrationPaciente().medicoResponsavelId is string
            && hydrationPaciente().medicoResponsavelId.size() > 0
              ? hydrationPaciente().medicoResponsavelId
              : (hydrationPaciente().medicoResponsavelID is string
                  ? hydrationPaciente().medicoResponsavelID
                  : '');
        }
        function isLinkedDoctor() {
          let medicoId = medicoResponsavelId();
          return request.auth != null
            && medicoId is string
            && medicoId.size() > 0
            && (
              medicoId == request.auth.uid
              || (
                exists(/databases/$(database)/documents/medicos/$(medicoId))
                && get(/databases/$(database)/documents/medicos/$(medicoId)).data.userId == request.auth.uid
              )
            );
        }
        function isLinkedNutritionist() {
          return request.auth != null
            && (
              (
                'nutricionistaVinculadoIds' in hydrationPaciente()
                && hydrationPaciente().nutricionistaVinculadoIds is list
                && request.auth.uid in hydrationPaciente().nutricionistaVinculadoIds
              )
              || (
                exists(/databases/$(database)/documents/paciente_nutricionista/$(pacienteId + '_' + request.auth.uid))
                && get(/databases/$(database)/documents/paciente_nutricionista/$(pacienteId + '_' + request.auth.uid)).data.status == 'ativo'
              )
            );
        }
        function isHydrationYmd() {
          return date.matches('^[0-9]{4}-[0-9]{2}-[0-9]{2}$');
        }
        function hydrationCreateShapeOk() {
          let d = request.resource.data;
          return d.keys().hasOnly([
              'date', 'goalMl', 'consumedMl', 'percentage', 'goalReached',
              'source', 'lastSource', 'patientId', 'userId',
              'createdAt', 'updatedAt', 'goalReachedAt'
            ])
            && d.patientId == pacienteId
            && d.userId == request.auth.uid
            && d.date == date
            && isHydrationYmd()
            && d.source == 'patient_portal'
            && d.lastSource == 'patient_portal'
            && d.goalMl is number
            && d.goalMl > 0
            && d.goalMl <= 15000
            && d.consumedMl is number
            && d.consumedMl >= 0
            && d.consumedMl <= 15000
            && d.percentage is number
            && d.percentage >= 0
            && d.goalReached is bool
            && d.createdAt is timestamp
            && d.updatedAt is timestamp
            && (!('goalReachedAt' in d) || d.goalReachedAt is timestamp);
        }
        function hydrationUpdateShapeOk() {
          let d = request.resource.data;
          let changed = d.diff(resource.data).affectedKeys();
          return changed.hasOnly([
              'consumedMl', 'percentage', 'goalReached',
              'lastSource', 'updatedAt', 'goalReachedAt'
            ])
            && d.patientId == resource.data.patientId
            && d.userId == resource.data.userId
            && d.date == resource.data.date
            && d.createdAt == resource.data.createdAt
            && d.goalMl == resource.data.goalMl
            && d.source == resource.data.source
            && d.consumedMl is number
            && d.consumedMl >= 0
            && d.consumedMl <= 15000
            && d.percentage is number
            && d.percentage >= 0
            && d.goalReached is bool
            && d.updatedAt is timestamp
            && d.lastSource == 'patient_portal'
            && (!('goalReachedAt' in d) || d.goalReachedAt is timestamp);
        }

        allow read: if isHydrationPatientOwner() || isLinkedDoctor() || isLinkedNutritionist();
        allow create: if isHydrationPatientOwner() && hydrationCreateShapeOk();
        allow update: if isHydrationPatientOwner() && hydrationUpdateShapeOk();
        allow delete: if false;
      }
    }

    // Token de check-in de hidratação (WhatsApp) — só Admin SDK
    match /hidratacao_checkin_links/{token} {
      allow read, write: if false;
    }

    match /hydration_checkin_deliveries/{id} {
      allow read, write: if false;
    }

    match /hydration_checkin_cron_state/{id} {
      allow read, write: if false;
    }

    match /hydration_adherence_alerts/{id} {
      allow read, write: if false;
    }
    
    // Avaliação Inicial para Atividade Física (Etapa 03) — paciente dono do userId
    match /avaliacaoAtividadeFisica/{patientId} {
      function isOwner() {
        return request.auth != null
          && resource.data.userId == request.auth.uid;
      }
      function isCreatingAsOwner() {
        return request.auth != null
          && request.resource.data.userId == request.auth.uid
          && request.resource.data.patientId == patientId
          && request.resource.data.createdBy == 'patient'
          && request.resource.data.lastUpdatedBy == 'patient';
      }
      function immutableIdentityPreserved() {
        return request.resource.data.userId == resource.data.userId
          && request.resource.data.patientId == resource.data.patientId
          && request.resource.data.createdBy == resource.data.createdBy;
      }

      allow create: if isCreatingAsOwner();
      allow read: if isOwner();
      allow update: if isOwner()
        && immutableIdentityPreserved()
        && request.resource.data.lastUpdatedBy == 'patient';
      allow delete: if false;
    }

    // Plano de treino publicado (Etapa 12) — prescrito, não sessão executada
    match /publishedTrainingPlans/{planId} {
      function isPlanPatient() {
        return request.auth != null
          && resource.data.patientUserId == request.auth.uid;
      }
      function isAuthed() {
        return request.auth != null;
      }
      function identityPreserved() {
        return request.resource.data.patientId == resource.data.patientId
          && request.resource.data.patientUserId == resource.data.patientUserId
          && request.resource.data.source.reviewedDraftId == resource.data.source.reviewedDraftId
          && request.resource.data.source.publishKey == resource.data.source.publishKey
          && request.resource.data.planVersion == resource.data.planVersion;
      }
      function createShapeOk() {
        return request.resource.data.patientId is string
          && request.resource.data.patientUserId is string
          && request.resource.data.professional.publishedBy == request.auth.uid
          && request.resource.data.status == 'active'
          && request.resource.data.version == 1;
      }

      // Paciente lê o próprio; profissionais autenticados leem (ACL fina no app/service)
      allow read: if isPlanPatient() || isAuthed();
      allow create: if isAuthed() && createShapeOk();
      // Update: supersede/cancel — identidade imutável; paciente não escreve
      allow update: if isAuthed()
        && resource.data.patientUserId != request.auth.uid
        && identityPreserved();
      allow delete: if false;
    }

    // Execução de sessão pelo paciente (Etapa 13) — não altera plano prescrito
    match /trainingSessionExecutions/{executionId} {
      function isExecutionOwner() {
        return request.auth != null
          && resource.data.patientUserId == request.auth.uid;
      }
      function isCreatingOwnExecution() {
        return request.auth != null
          && request.resource.data.patientUserId == request.auth.uid
          && request.resource.data.version == 1
          && request.resource.data.status == 'in_progress';
      }
      function executionIdentityPreserved() {
        return request.resource.data.patientId == resource.data.patientId
          && request.resource.data.patientUserId == resource.data.patientUserId
          && request.resource.data.organizationId == resource.data.organizationId
          && request.resource.data.source.publishedPlanId == resource.data.source.publishedPlanId
          && request.resource.data.source.prescribedSessionId == resource.data.source.prescribedSessionId
          && request.resource.data.source.planVersion == resource.data.source.planVersion
          && request.resource.data.createdAt == resource.data.createdAt;
      }

      allow read: if isExecutionOwner() || request.auth != null;
      allow create: if isCreatingOwnExecution();
      allow update: if isExecutionOwner() && executionIdentityPreserved();
      allow delete: if false;
    }
    
    // Regras para banners - leitura pública, escrita apenas autenticada
    match /banners/{bannerId} {
      allow read: if true; // Leitura pública para todos
      allow write: if request.auth != null; // Escrita apenas para usuários autenticados
    }

    // Central do Mentorado — leitura/escrita apenas via Admin SDK (APIs autenticadas)
    match /mentorContents/{contentId} {
      allow read, write: if false;
    }
    match /mentorTrails/{trailId} {
      allow read, write: if false;
    }
    match /mentorModules/{moduleId} {
      allow read, write: if false;
    }
    match /mentorTrailLessons/{lessonId} {
      allow read, write: if false;
    }
    match /mentorUserProgress/{progressId} {
      allow read, write: if false;
    }
    
    // Resumo derivado da carteira nutricional (ETAPA 08B)
    match /nutri_weekly_portfolio_summaries/{summaryId} {
      allow read, write: if request.auth != null;
    }

    // Match Saudável — só o dono lê e escreve o próprio perfil. Sem leitura cruzada.
    match /match_profiles/{uid} {
      allow read, create, update, delete: if request.auth != null && request.auth.uid == uid;
    }

    // Solicitações, conexões e bloqueios só existem via Admin SDK.
    // O cliente não cria conexão nem aceita solicitação direto no Firestore.
    match /match_connection_requests/{requestId} {
      allow read, write: if false;
    }
    match /match_connections/{pairKey} {
      allow read, write: if false;
    }
    match /match_blocks/{pairKey} {
      allow read, write: if false;
    }

    // Projeção pública mínima do Discovery. Só o Admin SDK escreve.
    match /match_discovery_profiles/{uid} {
      allow read, write: if false;
    }

    // Recusas do X. Só o Admin SDK grava.
    match /match_passes/{uid} {
      allow read, write: if false;
    }

    // Conversas só nascem no Admin SDK. Leitura do participante; escrita sempre no servidor.
    match /match_conversations/{pairKey} {
      allow read: if request.auth != null && request.auth.uid in resource.data.users;
      allow write: if false;

      match /messages/{messageId} {
        allow read: if request.auth != null
          && exists(/databases/$(database)/documents/match_connections/$(pairKey))
          && get(/databases/$(database)/documents/match_connections/$(pairKey)).data.status == 'active'
          && request.auth.uid in get(/databases/$(database)/documents/match_connections/$(pairKey)).data.users
          && !exists(/databases/$(database)/documents/match_blocks/$(pairKey));
        allow write: if false;
      }
    }

    // Fallback para outras collections — hidratação e Match ficam de fora
    match /{document=**} {
      allow read, write: if request.auth != null
        && !isHydrationProtectedPath()
        && !isMatchProfilePath()
        && !isMatchSocialPath();
    }
  }
}